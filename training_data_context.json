{"query":"","usedApproxTokens":23988,"chunks":[{"id":"acd006b81eb54cf4d732","path":"E:\\System-Model-Agent-Audit\\local-api\\api\\context-server.mjs","modifiedAt":"2026-08-22T23:51:49.545Z","approxTokens":706,"content":"import { createServer } from 'node:http';\nimport { readFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst port = Number(process.env.PORT || 4318);\nconst load = async name => JSON.parse(await readFile(path.join(root, 'data', name), 'utf8'));\nconst send = (res, code, data) => { res.writeHead(code, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' }); res.end(JSON.stringify(data)); };\nconst score = (chunk, terms) => terms.reduce((score, term) => score + ((`${chunk.path}\\n${chunk.content}`).toLowerCase().split(term).length - 1), 0);\nconst results = (corpus, q, limit) => corpus.chunks.map(x => ({ ...x, score: score(x, q.toLowerCase().split(/\\s+/).filter(Boolean)) })).filter(x => !q || x.score > 0).sort((a,b) => b.score - a.score).slice(0, limit);\ncreateServer(async (req, res) => {\n  if (req.method !== 'GET') return send(res, 405, { error: 'GET only' });\n  const url = new URL(req.url, `http://127.0.0.1:${port}`), q = url.searchParams.get('q') || '';\n  try {\n    const audit = await load('index.json');\n    if (url.pathname === '/health') return send(res, 200, { ok: true, auditGeneratedAt: audit.generatedAt });\n    if (url.pathname === '/v1/summary') return send(res, 200, audit.summary);\n    if (url.pathname === '/v1/timeline') return send(res, 200, audit.timeline);\n    const corpus = await load('corpus.json');\n    if (url.pathname === '/v1/corpus/stats') return send(res, 200, { generatedAt: corpus.generatedAt, profile: corpus.profile, stats: corpus.stats, safety: corpus.safety });\n    if (url.pathname === '/v1/corpus/search') return send(res, 200, results(corpus, q, Math.min(Number(url.searchParams.get('limit')) || 20, 100)).map(({ content, ...metadata }) => ({ ...metadata, preview: content.slice(0, 500) })));\n    if (url.pathname === '/v1/context') { let budget = Math.min(Number(url.searchParams.get('maxTokens')) || 6000, 24000); const pack = []; for (const chunk of results(corpus, q, 1000)) { if (chunk.approxTokens > budget) continue; budget -= chunk.approxTokens; pack.push({ id: chunk.id, path: chunk.path, modifiedAt: chunk.modifiedAt, approxTokens: chunk.approxTokens, content: chunk.content }); } return send(res, 200, { query: q, usedApproxTokens: (Number(url.searchParams.get('maxTokens')) || 6000) - budget, chunks: pack }); }\n    return send(res, 404, { error: 'Use /health, /v1/summary, /v1/timeline, /v1/corpus/stats, /v1/corpus/search, or /v1/context' });\n  } catch (error) { return send(res, 503, { error: 'Required index unavailable. Run the audit index and corpus index first.', detail: error.message }); }\n}).listen(port, '127.0.0.1', () => console.log(`Context API listening at http://127.0.0.1:${port}`));\n"},{"id":"d0781a1c3719f154126b","path":"E:\\System-Model-Agent-Audit\\local-api\\api\\identity-context-server.mjs","modifiedAt":"2026-08-22T23:57:41.469Z","approxTokens":933,"content":"import { createServer } from 'node:http';\nimport { timingSafeEqual } from 'node:crypto';\nimport { readFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst port = Number(process.env.PORT || 4318);\nconst identity = process.env.CONTEXT_API_IDENTITY;\nconst [REDACTED]\nif (!identity || !token) throw new Error('Set CONTEXT_API_IDENTITY and CONTEXT_API_TOKEN before starting the server.');\nconst load = async name => JSON.parse(await readFile(path.join(root, 'data', name), 'utf8'));\nconst send = (res, code, data) => { res.writeHead(code, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store', 'vary': 'Authorization, X-Context-Identity' }); res.end(JSON.stringify(data)); };\nconst equal = (left, right) => { const a = Buffer.from(left || ''), b = Buffer.from(right || ''); return a.length === b.length && timingSafeEqual(a, b); };\nconst authorized = req => equal(req.headers['x-context-identity'], identity) && equal((req.headers.authorization || '').replace(/^Bearer\\s+/i, ''), token);\nconst score = (chunk, terms) => terms.reduce((sum, term) => sum + ((`${chunk.path}\\n${chunk.content}`).toLowerCase().split(term).length - 1), 0);\nconst find = (corpus, query, maximum) => corpus.chunks.map(chunk => ({ ...chunk, score: score(chunk, query.toLowerCase().split(/\\s+/).filter(Boolean)) })).filter(chunk => !query || chunk.score > 0).sort((a, b) => b.score - a.score).slice(0, maximum);\n\ncreateServer(async (req, res) => {\n  if (!authorized(req)) return send(res, 401, { error: 'Identity proof required. Supply matching Authorization: Bearer <token> and X-Context-Identity headers.' });\n  if (req.method !== 'GET') return send(res, 405, { error: 'GET only' });\n  const url = new URL(req.url, `http://127.0.0.1:${port}`), query = url.searchParams.get('q') || '';\n  try {\n    const audit = await load('index.json');\n    if (url.pathname === '/health') return send(res, 200, { ok: true, identity, auditGeneratedAt: audit.generatedAt });\n    if (url.pathname === '/v1/summary') return send(res, 200, { identity, ...audit.summary });\n    if (url.pathname === '/v1/timeline') return send(res, 200, { identity, timeline: audit.timeline });\n    const corpus = await load('corpus.json');\n    if (url.pathname === '/v1/corpus/stats') return send(res, 200, { identity, generatedAt: corpus.generatedAt, profile: corpus.profile, stats: corpus.stats, safety: corpus.safety });\n    if (url.pathname === '/v1/corpus/search') return send(res, 200, find(corpus, query, Math.min(Number(url.searchParams.get('limit')) || 20, 100)).map(({ content, ...metadata }) => ({ identity, ...metadata, preview: content.slice(0, 500) })));\n    if (url.pathname === '/v1/context') {\n      const requested = Math.min(Number(url.searchParams.get('maxTokens')) || 6000, 24000); let remaining = requested; const chunks = [];\n      for (const chunk of find(corpus, query, 1000)) { if (chunk.approxTokens <= remaining) { remaining -= chunk.approxTokens; chunks.push({ identity, id: chunk.id, path: chunk.path, modifiedAt: chunk.modifiedAt, approxTokens: chunk.approxTokens, content: chunk.content }); } }\n      return send(res, 200, { identity, query, usedApproxTokens: requested - remaining, chunks });\n    }\n    return send(res, 404, { error: 'Use /health, /v1/summary, /v1/timeline, /v1/corpus/stats, /v1/corpus/search, or /v1/context' });\n  } catch (error) { return send(res, 503, { error: 'Required index unavailable. Build both indexes first.', detail: error.message }); }\n}).listen(port, '127.0.0.1', () => console.log(`Identity-bound Context API listening at http://127.0.0.1:${port} for ${identity}`));\n"},{"id":"9214803040ff03ada4a1","path":"E:\\System-Model-Agent-Audit\\local-api\\api\\server.mjs","modifiedAt":"2026-08-22T23:47:04.963Z","approxTokens":563,"content":"import { createError, serve } from 'micro';\nimport { readFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\nconst indexPath = path.join(root, 'data', 'index.json');\nconst port = Number(process.env.PORT || 4318);\nconst load = async () => { try { return JSON.parse(await readFile(indexPath, 'utf8')); } catch { throw createError(503, 'Index unavailable. Run: npm run index'); } };\nconst limit = v => Math.min(Math.max(Number.parseInt(v || '100', 10) || 100, 1), 1000);\nconst match = (item, q) => !q || JSON.stringify(item).toLowerCase().includes(q.toLowerCase());\nconst handler = async (req, res) => {\n  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);\n  res.setHeader('Access-Control-Allow-Origin', `http://127.0.0.1:${port}`); res.setHeader('Cache-Control', 'no-store');\n  if (req.method !== 'GET') throw createError(405, 'GET only');\n  const data = await load(), q = url.searchParams.get('q') || '', max = limit(url.searchParams.get('limit'));\n  if (url.pathname === '/health') return { ok: true, generatedAt: data.generatedAt, schemaVersion: data.schemaVersion };\n  if (url.pathname === '/v1/summary') return data.summary;\n  if (url.pathname === '/v1/models') return data.models.filter(x => match(x, q)).slice(0, max);\n  if (url.pathname === '/v1/runtimes') return data.runtimes.filter(x => match(x, q)).slice(0, max);\n  if (url.pathname === '/v1/findings') return data.findings.filter(x => match(x, q)).slice(0, max);\n  if (url.pathname === '/v1/timeline') { const kind = url.searchParams.get('kind'), since = url.searchParams.get('since'), until = url.searchParams.get('until'); return data.timeline.filter(x => match(x, q) && (!kind || x.kind === kind) && (!since || (x.at && x.at >= since)) && (!until || (x.at && x.at <= until))).slice(0, max); }\n  if (url.pathname === '/v1/search') return data.timeline.filter(x => match(x, q)).slice(0, max);\n  throw createError(404, 'Use /health, /v1/summary, /v1/models, /v1/runtimes, /v1/timeline, /v1/findings, or /v1/search');\n};\nserve(handler, { port, hostname: '127.0.0.1' });\nconsole.log(`Audit API listening at http://127.0.0.1:${port}`);\n"},{"id":"a6ffa7a3ff7392b458cc","path":"E:\\System-Model-Agent-Audit\\local-api\\context\\Build-Corpus.mjs","modifiedAt":"2026-08-22T23:51:49.545Z","approxTokens":995,"content":"import { createHash } from 'node:crypto';\nimport { mkdir, readdir, readFile, stat, writeFile } from 'node:fs/promises';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst apiRoot = path.resolve(here, '..');\nconst config = JSON.parse(await readFile(path.join(here, 'corpus.config.json'), 'utf8'));\nconst profile = process.argv.includes('--profile') ? process.argv[process.argv.indexOf('--profile') + 1] : 'audit';\nconst roots = config.profiles[profile];\nif (!roots) throw new Error(`Unknown profile: ${profile}`);\nconst importDir = config.sessionImportDirectory;\nconst output = path.join(apiRoot, 'data', 'corpus.json');\nconst extensions = new Set(['.js','.mjs','.cjs','.ts','.tsx','.jsx','.py','.ps1','.sh','.bat','.cmd','.go','.rs','.java','.c','.cc','.cpp','.h','.hpp','.cs','.rb','.php','.sql','.html','.css','.scss','.md','.txt','.json','.yaml','.yml','.toml','.ini','.xml','.csv','.jsonl']);\nconst excludedDirs = new Set(['.git','node_modules','.next','dist','build','coverage','.cache','.venv','venv','__pycache__','appdata','windows','program files','program files (x86)','programdata','$recycle.bin','system volume information','.ollama']);\nconst blockedName = /(^|[._-])(env|credentials?|secrets?|id_rsa|id_ed25519|known_hosts|token|wallet|password)([._-]|$)/i;\nconst secretPatterns = [/(sk-[A-Za-z0-9_-]{16,})/g, /(AKIA[0-9A-Z]{16})/g, /(gh[pousr]_[A-Za-z0-9_]{20,})/g, /(AIza[0-9A-Za-z_-]{20,})/g, /((?:api[_-]?key|token|password|secret)\\s*[:=]\\s*[\"']?)[^\\s,\"']+/gi];\nconst redact = text => secretPatterns.reduce((value, pattern) => value.replace(pattern, (_, prefix) => prefix && prefix.endsWith?.('=') ? `${prefix}[REDACTED]` : '[REDACTED]'), text);\nconst chunks = [];\nconst stats = { filesVisited: 0, filesIndexed: 0, skippedSensitive: 0, skippedSize: 0, skippedType: 0, errors: 0 };\nasync function visit(root) {\n  let entries; try { entries = await readdir(root, { withFileTypes: true }); } catch { stats.errors++; return; }\n  for (const entry of entries) {\n    const target = path.join(root, entry.name);\n    if (entry.isDirectory()) { if (!excludedDirs.has(entry.name.toLowerCase())) await visit(target); continue; }\n    if (!entry.isFile()) continue;\n    stats.filesVisited++;\n    const ext = path.extname(entry.name).toLowerCase();\n    if (!extensions.has(ext)) { stats.skippedType++; continue; }\n    if (blockedName.test(entry.name) || /\\\\\\.ssh\\\\|\\\\\\.aws\\\\|\\\\\\.azure\\\\|\\\\\\.config\\\\gh\\\\|\\\\\\.config\\\\gcloud\\\\/i.test(target)) { stats.skippedSensitive++; continue; }\n    let info; try { info = await stat(target); } catch { stats.errors++; continue; }\n    if (info.size > config.maxFileBytes) { stats.skippedSize++; continue; }\n    let text; try { text = redact(await readFile(target, 'utf8')); } catch { stats.errors++; continue; }\n    if (!text.trim()) continue;\n    for (let offset = 0, ordinal = 0; offset < text.length; offset += config.chunkCharacters, ordinal++) {\n      const content = text.slice(offset, offset + config.chunkCharacters);\n      const id = createHash('sha256').update(`${target}:${ordinal}:${content}`).digest('hex').slice(0, 20);\n      chunks.push({ id, path: target, kind: target.startsWith(importDir) ? 'session_export' : 'code_or_text', modifiedAt: info.mtime.toISOString(), bytes: info.size, ordinal, approxTokens: Math.ceil(content.length / 4), content });\n    }\n    stats.filesIndexed++;\n  }\n}\nfor (const root of [...roots, importDir]) await visit(root);\nconst corpus = { schemaVersion: '1.0', generatedAt: new Date().toISOString(), profile, roots, safety: 'Content is restricted to safe text/code extensions, filtered paths, redacted token-like values, and size limits.', stats: { ...stats, chunks: chunks.length, approxTokens: chunks.reduce((n, x) => n + x.approxTokens, 0) }, chunks };\nawait mkdir(path.dirname(output), { recursive: true });\nawait writeFile(output, JSON.stringify(corpus), 'utf8');\nconsole.log(JSON.stringify(corpus.stats));\n"},{"id":"cbb02335bcf335d0511f","path":"E:\\System-Model-Agent-Audit\\local-api\\context\\corpus.config.json","modifiedAt":"2026-08-22T23:51:49.544Z","approxTokens":67,"content":"{\n  \"profiles\": {\n    \"audit\": [\"E:\\\\System-Model-Agent-Audit\"],\n    \"approved-code\": [\"C:\\\\Users\\\\JJ\", \"E:\\\\\", \"N:\\\\\"]\n  },\n  \"sessionImportDirectory\": \"E:\\\\System-Model-Agent-Audit\\\\local-api\\\\session-imports\",\n  \"maxFileBytes\": 2097152,\n  \"chunkCharacters\": 5000\n}\n"},{"id":"fc62b70e37c8541f874e","path":"E:\\System-Model-Agent-Audit\\local-api\\context\\README.md","modifiedAt":"2026-08-22T23:51:49.544Z","approxTokens":173,"content":"# Retrieval corpus\n\nRun `node context/Build-Corpus.mjs --profile audit` to index the audit repository, or `node context/Build-Corpus.mjs --profile approved-code` to scan approved developer roots for safe code/text files. The broader profile can take a long time.\n\nTo add your own exported session/context history, put `.jsonl`, `.json`, `.md`, or `.txt` exports in `session-imports/`; they are chunked and redacted during indexing. Internal Codex/ChatGPT session storage is never read directly.\n\nThe index rejects secret-bearing paths and redacts token-like values. It does not include model weights, binaries, browser data, private keys, cloud credentials, `.env` files, or package caches.\n"},{"id":"8bfcb277fe5a7b38810a","path":"E:\\System-Model-Agent-Audit\\local-api\\CONTEXT-API.md","modifiedAt":"2026-08-22T23:52:50.097Z","approxTokens":300,"content":"# Context retrieval API\n\nStart the verified local API:\n\n```powershell\nSet-Location E:\\System-Model-Agent-Audit\\local-api\n.\\Start-ContextApi.ps1\n```\n\nIt binds only to `127.0.0.1:4318`.\n\n| Endpoint | Purpose |\n| --- | --- |\n| `/health` | Health and audit-index time |\n| `/v1/summary` | Hardware/model/runtime aggregate metadata |\n| `/v1/timeline` | Observable process/service/model-store timeline |\n| `/v1/corpus/stats` | Safe corpus coverage and approximate token count |\n| `/v1/corpus/search?q=...` | Metadata plus 500-character redacted previews |\n| `/v1/context?q=...&maxTokens=6000` | Token-budgeted redacted chunks for model context |\n\nTo index approved code/text roots instead of only this audit repository, run:\n\n```powershell\nnode .\\context\\Build-Corpus.mjs --profile approved-code\nnode .\\api\\context-server.mjs\n```\n\nThe broader profile can take a long time. It is intentionally restricted to safe text/code extensions, ignores common build/cache/system directories, rejects sensitive filenames, redacts common token formats, and keeps raw model weights, credentials, keys, browser data, and private session stores out of the API. Add only user-exported context history to `session-imports`.\n"},{"id":"176fcf315bc9d3eb57ad","path":"E:\\System-Model-Agent-Audit\\local-api\\data\\corpus.json","modifiedAt":"2026-08-22T23:52:00.226Z","approxTokens":1250,"content":"{\"schemaVersion\":\"1.0\",\"generatedAt\":\"2026-08-22T23:52:00.223Z\",\"profile\":\"audit\",\"roots\":[\"E:\\\\System-Model-Agent-Audit\"],\"safety\":\"Content is restricted to safe text/code extensions, filtered paths, redacted token-like values, and size limits.\",\"stats\":{\"filesVisited\":21,\"filesIndexed\":18,\"skippedSensitive\":0,\"skippedSize\":0,\"skippedType\":3,\"errors\":1,\"chunks\":50,\"approxTokens\":48866},\"chunks\":[{\"id\":\"acd006b81eb54cf4d732\",\"path\":\"E:\\\\System-Model-Agent-Audit\\\\local-api\\\\api\\\\context-server.mjs\",\"kind\":\"code_or_text\",\"modifiedAt\":\"2026-08-22T23:51:49.545Z\",\"bytes\":2822,\"ordinal\":0,\"approxTokens\":706,\"content\":\"import { createServer } from 'node:http';\\nimport { readFile } from 'node:fs/promises';\\nimport path from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\n\\nconst root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');\\nconst port = Number(process.env.PORT || 4318);\\nconst load = async name => JSON.parse(await readFile(path.join(root, 'data', name), 'utf8'));\\nconst send = (res, code, data) => { res.writeHead(code, { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' }); res.end(JSON.stringify(data)); };\\nconst score = (chunk, terms) => terms.reduce((score, term) => score + ((`${chunk.path}\\