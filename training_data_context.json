ty\\\": \\\"sha512-yaOH/Pk/VEhBWWTlhI+qXxDFXlejDGcQipMlyxda9nthulaxLZUNcUqFxokp0vcYnvteJln5FNQDRrxj3YcbVw==\\\",\\n      \\\"license\\\": \\\"MIT\\\",\\n   \"},{\"id\":\"cd013924ee18d56cf826"},{"id":"7419d5664221c1a275de","path":"E:\\System-Model-Agent-Audit\\local-api\\data\\corpus.json","modifiedAt":"2026-08-22T23:52:00.226Z","approxTokens":1250,"content":"\",\"path\":\"E:\\\\System-Model-Agent-Audit\\\\local-api\\\\package-lock.json\",\"kind\":\"code_or_text\",\"modifiedAt\":\"2026-08-22T23:47:28.348Z\",\"bytes\":5390,\"ordinal\":1,\"approxTokens\":98,\"content\":\"   \\\"engines\\\": {\\n        \\\"node\\\": \\\">=0.6\\\"\\n      }\\n    },\\n    \\\"node_modules/unpipe\\\": {\\n      \\\"version\\\": \\\"1.0.0\\\",\\n      \\\"resolved\\\": \\\"https://registry.npmjs.org/unpipe/-/unpipe-1.0.0.tgz\\\",\\n      \\\"integrity\\\": \\\"sha512-pjy2bYhSsufwWlKwPc+l3cN7+wuJlK6uz0YdJEOlQDbl6jo/YlPi4mb8agUkVC8BF7V8NuzeyPNqRksA3hztKQ==\\\",\\n      \\\"license\\\": \\\"MIT\\\",\\n      \\\"engines\\\": {\\n        \\\"node\\\": \\\">= 0.8\\\"\\n      }\\n    }\\n  }\\n}\\n\"},{\"id\":\"c66666151fac0a5a8b69\",\"path\":\"E:\\\\System-Model-Agent-Audit\\\\local-api\\\\package.json\",\"kind\":\"code_or_text\",\"modifiedAt\":\"2026-08-22T23:47:01.895Z\",\"bytes\":319,\"ordinal\":0,\"approxTokens\":80,\"content\":\"{\\n  \\\"name\\\": \\\"local-model-agent-audit-api\\\",\\n  \\\"version\\\": \\\"0.1.0\\\",\\n  \\\"private\\\": true,\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"scripts\\\": {\\n    \\\"index\\\": \\\"node scripts/Build-Index.mjs\\\",\\n    \\\"start\\\": \\\"node api/server.mjs\\\",\\n    \\\"dev\\\": \\\"node scripts/Build-Index.mjs && node api/server.mjs\\\"\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"micro\\\": \\\"^10.0.1\\\"\\n  }\\n}\\n\"},{\"id\":\"70b874da80040bc95a9a\",\"path\":\"E:\\\\System-Model-Agent-Audit\\\\local-api\\\\README.md\",\"kind\":\"code_or_text\",\"modifiedAt\":\"2026-08-22T23:47:04.894Z\",\"bytes\":590,\"ordinal\":0,\"approxTokens\":148,\"content\":\"# Local Audit API\\n\\nThis localhost-only API indexes metadata generated by the parent audit repository. It does not expose model weights, secrets, credentials, private keys, source contents, chat history, or hidden model reasoning.\\n\\n```powershell\\nSet-Location E:\\\\System-Model-Agent-Audit\\\\local-api\\nnpm install\\nnpm run index\\nnpm start\\n```\\n\\nEndpoints:\\n\\n- `GET /health`\\n- `GET /v1/summary`\\n- `GET /v1/models?q=ollama`\\n- `GET /v1/runtimes`\\n- `GET /v1/timeline?kind=process&since=2026-08-01&limit=100`\\n- `GET /v1/findings`\\n- `GET /v1/search?q=quantum`\\n\\nThe service binds to `127.0.0.1:4318` only.\\n\"},{\"id\":\"fb8e358799e65f445d11\",\"path\":\"E:\\\\System-Model-Agent-Audit\\\\local-api\\\\scripts\\\\Build-Index.mjs\",\"kind\":\"code_or_text\",\"modifiedAt\":\"2026-08-22T23:47:04.961Z\",\"bytes\":4083,\"ordinal\":0,\"approxTokens\":1021,\"content\":\"import { createHash } from 'node:crypto';\\nimport { mkdir, readFile, writeFile } from 'node:fs/promises';\\nimport path from 'node:path';\\nimport { fileURLToPath } from 'node:url';\\n\\nconst here = path.dirname(fileURLToPath(import.meta.url));\\nconst apiRoot = path.resolve(here, '..');\\nconst reports = path.resolve(apiRoot, '..', 'reports', 'latest');\\nconst output = path.join(apiRoot, 'data', 'index.json');\\nasync function optionalJson(name) { try { return JSON.parse(await readFile(path.join(reports, name), 'utf8')); } catch { return null; } }\\nconst list = value => Array.isArray(value) ? value : value ? [value] : [];\\nconst eventId = event => createHash('sha256').update(JSON.stringify(event)).digest('hex').slice(0, 16);\\nconst [system, commands, stores, processes, services] = await Promise.all([\\n  optionalJson('01-system.json'), optionalJson('05-runtime-commands.json'), optionalJson('06-model-store-locations.json'), optionalJson('03-relevant-processes.json'), optionalJson('04-relevant-services.json')\\n]);\\nconst timeline = [];\\nfor (const store of list(stores)) timeline.push({ at: store.LastWriteTimeUtc ?? null, kind: 'model_store', subject: store.Path, metrics: { bytes: Number(store.TotalBytes ?? 0) }, evidence: ['Directory metadata only; model file contents were not read.'] });\\nfor (const process of list(processes)) if (process.StartTime) timeline.push({ at: process.StartTime, kind: 'process', subject: process.Name, metrics: { pid: process.Id, threads: process.Threads, workingSetBytes: process.WorkingSetBytes }, evidence: [process.Path ? `Executable path observed: ${process.Path}` : 'Executable path unavailable from telemetry.'] });\\nfor (const service of list(services)) if (/quantum|qubit/i.test(`${service.Name} ${service.DisplayName} ${service.PathName}`)) timeline.push({ at: null, kind: 'quantum_claimed_service', subject: service.Name, status: service.State, metrics: { processId: service.ProcessId }, evidence: [service.DisplayName, service.PathName].filter(Boolean), finding: 'Name/path claims quantum functionality. This is not evidence of physical quantum computation.' });\\nfor (const event of timeline) event.id = eventId(event);\\ntimeline.sort((a, b) => (b.at ?? '').localeCompare(a.at ?? ''));\\nconst runtimes = list(commands).map(x => ({ name: x.Name, available: Boolean(x.Available), commandType: x.CommandType, path: x.Path }));\\nconst available = runtimes.filter(x => x.available).map(x => x.name);\\nconst quantumRuntimeDetected = available.some(x => /qiskit|qbraid/i.test(x));\\nconst index = {\\n  schemaVersion: '1.0', generatedAt: new Date().toISOString(), source: 'Parent reports/latest (metadata-only)',\\n  safety: { exposed: 'Audit metadata, aggregate metrics, observable process/service evidence, a"},{"id":"a301256976435b88fddf","path":"E:\\System-Model-Agent-Audit\\local-api\\data\\corpus.json","modifiedAt":"2026-08-22T23:52:00.226Z","approxTokens":1250,"content":"nd derived findings.', excluded: 'Model weights, source contents, private keys, tokens, credentials, browser data, chat history, and hidden model reasoning.' },\\n  summary: { modelStoreCount: list(stores).length, totalModelBytes: list(stores).reduce((n, x) => n + Number(x.TotalBytes ?? 0), 0), activeRuntimeCommands: available, quantumRuntimeDetected, quantumAssessment: quantumRuntimeDetected ? 'A quantum SDK-related command was detected; use its own logs to inspect simulation work.' : 'No quantum SDK command was found. Quantum-named services are indexed as claims only, not verified quantum operations.', system: system ? { computerModel: system.ComputerSystem?.Model, ramBytes: Number(system.ComputerSystem?.TotalPhysicalMemory ?? 0), logicalProcessors: system.ComputerSystem?.NumberOfLogicalProcessors, gpus: list(system.GPUs).map(x => x.Name) } : null },\\n  models: list(stores).map(x => ({ path: x.Path, totalBytes: Number(x.TotalBytes ?? 0), lastWriteTimeUtc: x.LastWriteTimeUtc })), runtimes, timeline,\\n  findings: timeline.filter(x => x.finding).map(({ id, kind, subject, finding, evidence }) => ({ id, kind, subject, finding, evidence }))\\n};\\nawait mkdir(path.dirname(output), { recursive: true });\\nawait writeFile(output, JSON.stringify(index, null, 2) + '\\\\n', 'utf8');\\nconsole.log(`Indexed ${timeline.length} timeline events in ${output}`);\\n\"},{\"id\":\"d296bd66aa0fadd6d3bb\",\"path\":\"E:\\\\System-Model-Agent-Audit\\\\README.md\",\"kind\":\"code_or_text\",\"modifiedAt\":\"2026-08-22T23:35:01.762Z\",\"bytes\":2014,\"ordinal\":0,\"approxTokens\":504,\"content\":\"# System Model & Agent Audit\\n\\nThis repository holds a local, metadata-only inventory of this Windows machine's developer tooling, AI model stores, running processes and services, repositories, and hardware capacity.\\n\\n## Safety boundary\\n\\nThe collector never reads or copies credential values, private keys, tokens, model payloads, chat history, browser data, or source-file contents. It records only paths, sizes, hashes of the *inventory reports*, process/service metadata, and environment-variable **names** that look credential-related.\\n\\n`reports/latest/` is replaced on each collection run and is intentionally ignored by Git. To preserve a reviewed snapshot, copy it to `reports/snapshots/<date>/` and commit that snapshot only after checking it for sensitive paths or proprietary information.\\n\\n## Run\\n\\nOpen PowerShell and run:\\n\\n```powershell\\nSet-Location E:\\\\System-Model-Agent-Audit\\n.\\\\scripts\\\\Collect-SystemAudit.ps1\\n```\\n\\nThe script is read-only outside this repository. It can take a few minutes because it searches the conventional local-model locations and developer roots on `C:`, `E:`, and `N:`.\\n\\n## What is included\\n\\n- disk, CPU, RAM, GPU, logical processor, and active process/thread usage;\\n- running terminal/editor/agent/model-related processes and Windows services;\\n- installed commands and packages for common agent and model runtimes;\\n- Git repositories found in the configured developer roots (metadata only);\\n- local model artifacts (`.gguf`, `.safetensors`, `.onnx`, etc.) and common model stores, with path, size, and last-write time only;\\n- Vercel CLI/project configuration presence (without reading deployment tokens);\\n- credential-management tooling/configuration *locations* and credential-like environment-variable names only.\\n\\n\\\"Quantum operations\\\" is reported accurately as **not observable from standard Windows telemetry** unless a locally installed quantum SDK, simulator, or service is detected. No claim about physical quantum computation is made without verifiable local evidence.\\n\"},{\"id\":\"687f6f6a27e8386c0a20\",\"path\":\"E:\\\\System-Model-Agent-Audit\\\\reports\\\\latest\\\\01-system.json\",\"kind\":\"code_or_text\",\"modifiedAt\":\"2026-08-22T23:35:20.865Z\",\"bytes\":1826,\"ordinal\":0,\"approxTokens\":457,\"content\":\"{\\r\\n  \\\"GeneratedAt\\\": \\\"2026-08-22T19:35:19.4468004-04:00\\\",\\r\\n  \\\"ComputerSystem\\\": {\\r\\n    \\\"Manufacturer\\\": \\\"Micro-Star International Co., Ltd.\\\",\\r\\